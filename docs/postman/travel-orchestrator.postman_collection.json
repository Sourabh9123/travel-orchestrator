{
  "info": {
    "_postman_id": "7a4e0fc1-b62a-49c8-8f35-8b8b0f2e0b4a",
    "name": "travel-orchestrator",
    "description": "Importable Postman collection for the local travel-orchestrator API. Start the stack, run migrations, then create a travel plan first so the collection scripts can save workflow_id and trip_id variables for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
