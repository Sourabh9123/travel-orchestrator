    {
      "name": "Travel Planning",
      "item": [
        {
          "name": "Create Travel Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request accepted', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.workflow_id) {",
                  "  pm.collectionVariables.set('workflow_id', json.workflow_id);",
                  "}",
                  "if (json.trip_id) {",
                  "  pm.collectionVariables.set('trip_id', json.trip_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Plan a 5 day culture and food trip to Lisbon for two people under 2500 USD\",\n  \"origin\": \"New York\",\n  \"destination\": \"Lisbon\",\n  \"travelers\": 2,\n  \"budget_amount\": 2500,\n  \"currency\": \"USD\",\n  \"preferences\": [\n    \"food\",\n    \"walkable neighborhoods\",\n    \"history\"\n  ],\n  \"travel_style\": \"culture\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/travel/plan",
              "host": [
                "{{base_url}}{{api_prefix}}"
              ],
              "path": [
                "travel",
                "plan"
              ]
            },
            "description": "Creates a trip and starts the background travel planning workflow. The test script saves workflow_id and trip_id into collection variables."
          },
          "response": []
        },
        {
          "name": "Get Travel Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/travel/status/{{workflow_id}}",
              "host": [
                "{{base_url}}{{api_prefix}}"
              ],
              "path": [
                "travel",
                "status",
                "{{workflow_id}}"
              ]
            },
            "description": "Poll workflow state and final plan output. Run Create Travel Plan first."
          },
          "response": []
        },
        {
          "name": "Validate Travel Plan",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/travel/validate?workflow_id={{workflow_id}}",
              "host": [
                "{{base_url}}{{api_prefix}}"
              ],
              "path": [
                "travel",
                "validate"
              ],
              "query": [
                {
                  "key": "workflow_id",
                  "value": "{{workflow_id}}"
                }
              ]
            },
            "description": "Returns validation results for a workflow. Run Create Travel Plan first, then wait for validation to complete."
          },
          "response": []
        },
        {
          "name": "Replan Travel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replan accepted', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.workflow_id) {",
                  "  pm.collectionVariables.set('workflow_id', json.workflow_id);",
                  "}",
                  "if (json.trip_id) {",
                  "  pm.collectionVariables.set('trip_id', json.trip_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflow_id\": \"{{workflow_id}}\",\n  \"prompt\": \"Replan this trip with a slower pace and more food experiences.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/travel/replan",
              "host": [
                "{{base_url}}{{api_prefix}}"
              ],
              "path": [
                "travel",
                "replan"
              ]
            },
            "description": "Creates a new plan based on the prior workflow's final requirements. The script updates workflow_id and trip_id to the new workflow."
          },
          "response": []
        },
        {
          "name": "Travel History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/travel/history?user_id={{user_id}}&limit=25",
              "host": [
                "{{base_url}}{{api_prefix}}"
              ],
              "path": [
                "travel",
                "history"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "Lists recent trips for a user id. The API currently accepts user_id as a query parameter."
          },
          "response": []
        },
        {
          "name": "Workflow Events WebSocket URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ws_url}}{{api_prefix}}/travel/ws/{{workflow_id}}",
              "host": [
                "{{ws_url}}{{api_prefix}}"
              ],
              "path": [
                "travel",
                "ws",
                "{{workflow_id}}"
              ]
            },
            "description": "Use this URL in Postman's WebSocket client: {{ws_url}}{{api_prefix}}/travel/ws/{{workflow_id}}"
          },
          "response": []
        }
      ]
    },
