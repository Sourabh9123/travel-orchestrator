APP_NAME=travel-orchestrator
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/v1
API_PORT=8000
SECRET_KEY=replace-me-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=travel_orchestrator
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
DB_CONNECT_RETRY_ATTEMPTS=10
DB_CONNECT_RETRY_DELAY_SECONDS=1.0

REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

MEMORY_TTL_SECONDS=86400
TOOL_TIMEOUT_SECONDS=20
AGENT_TIMEOUT_SECONDS=60
WORKFLOW_TIMEOUT_SECONDS=180

PROMETHEUS_PORT=9090
PROMETHEUS_HOST_PORT=9090

GRAFANA_PORT=3000
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

OTEL_EXPORTER_OTLP_ENDPOINT=
